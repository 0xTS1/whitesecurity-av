<% const title = 'Daftar — WhiteSecurity Portal' %>
<%- include('partials/header', { title }) %>
<div class="container" style="max-width:420px;">
  <h1>Buat Akun</h1>
  <p class="subtitle">Daftar untuk membeli dan mengelola lisensi WhiteSecurity.</p>
  <% if (error) { %><div class="error-banner"><%= error %></div><% } %>
  <div class="card">
    <form method="POST" action="/antivirus/register">
      <label>Nama</label>
      <input type="text" name="name">
      <label>Email</label>
      <input type="email" name="email" required autofocus>
      <label>Password (min. 8 karakter)</label>
      <input type="password" name="password" minlength="8" required>
      <button type="submit">Daftar</button>
    </form>
  </div>
  <p class="subtitle">Sudah punya akun? <a href="/antivirus/login">Masuk di sini</a>.</p>
</div>
<%- include('partials/footer') %>
