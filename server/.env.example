# Copy this file to .env and fill in real values before starting the server.

# Port the HTTP API listens on
PORT=8787

# Shared secret the Android app must send as the "X-Api-Key" header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_API_KEY=changeme-generate-a-real-random-key

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/whitesecurity.db

# --- Web portal (user + admin dashboard, Midtrans payments) ---
# None of these fail server boot if missing — the Android API stays up
# either way. Payment routes just return a friendly error until set.

# "production" enables Secure-flagged session cookies — only set this once
# the portal is actually served over HTTPS (behind nginx/Caddy).
NODE_ENV=development

# Public URL this server is reachable at — used to build Midtrans callback
# URLs. Set to your real https://... domain in production.
PORTAL_BASE_URL=http://localhost:8787

# Name of the portal session cookie — rarely needs changing.
SESSION_COOKIE_NAME=wsec_session

# Midtrans server-side API key (Settings > Access Keys in the Midtrans
# dashboard). Keep this secret — never expose it to the browser.
MIDTRANS_SERVER_KEY=

# Midtrans client-side key — safe to expose, kept here for symmetry/future
# use if client-side Snap.js is ever added.
MIDTRANS_CLIENT_KEY=

# "true" to use Midtrans's production endpoints; otherwise sandbox is used.
MIDTRANS_IS_PRODUCTION=false
